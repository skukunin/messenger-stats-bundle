{
    "name": "skukunin/messenger-stats-bundle",
    "description": "Queue statistics, health check and Prometheus metrics for Symfony Messenger transports",
    "type": "symfony-bundle",
    "keywords": ["symfony", "messenger", "monitoring", "prometheus", "health-check"],
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Kukunin",
            "email": "serhii.kukunin@securemails.com.ua"
        }
    ],
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^2.13 || ^3.0 || ^4.0",
        "doctrine/persistence": "^2.2 || ^3.0 || ^4.0",
        "psr/log": "^1 || ^2 || ^3",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/doctrine-messenger": "^5.4 || ^6.4 || ^7.0",
        "symfony/event-dispatcher": "^5.4 || ^6.4 || ^7.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/messenger": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.7",
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpro/grumphp": "^2.23",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.4 || ^2.0",
        "phpstan/phpstan-symfony": "^1.4 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.0",
        "symfony/property-access": "^5.4 || ^6.4 || ^7.0",
        "symfony/serializer": "^5.4 || ^6.4 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Skukunin\\MessengerStatsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skukunin\\MessengerStatsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
